# ── Existing ─────────────────────────────────────────────
PORT=3001
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=

# ── Solana ───────────────────────────────────────────────
# devnet while testing, mainnet-beta for launch
SOLANA_CLUSTER=devnet
# RPC endpoint. Required on mainnet: a paid one (Helius, Triton, QuickNode).
SOLANA_RPC_URL=
# LEAVE EMPTY for lite mode (mainnet v1: no custom program, nothing to deploy).
# Set it to the program ID printed by `anchor deploy` to use the Velfi program.
VELFI_PROGRAM_ID=
# Velfi's fee payer: pays network fees and token-account rent so users never need SOL.
# Paste the JSON array from a keypair file, e.g. `cat ~/.config/solana/velfi-fee-payer.json`
VELFI_FEE_PAYER_KEY=
# Autopilot agent key: the only key allowed to send scheduled payments
# (lite: the approved spender on users' token accounts). Keep separate from the fee payer.
VELFI_AGENT_KEY=
# optional: override the USDC mint (e.g. your own devnet test mint)
USDC_MINT=
# optional: priority fee in micro-lamports per compute unit
PRIORITY_MICROLAMPORTS=1000
# optional: max fee-paid transactions per user per hour
MAX_TX_PER_HOUR=60
# optional: run schedules every N seconds for demos (devnet only; mainnet refuses to start with it)
SCHEDULE_DEMO_SECS=
# Fee payer protection: new token accounts Velfi pays rent for (~0.002 SOL each)
MAX_NEW_ACCOUNTS_PER_DAY=10
MAX_NEW_ACCOUNTS_GLOBAL_PER_DAY=200
# Pause new payments (and fail /health) below this fee payer balance
MIN_FEE_PAYER_SOL=0.05
# Largest total one schedule may cover (amount x payments), in that token
MAX_SCHEDULE_TOTAL=500

# Kill switch: 'on' stops new payments, scheduled payments and invite moves at once
PAUSE_PAYMENTS=
# 'off' turns off sending to email addresses (the money would otherwise wait in a
# holding wallet Velfi manages for up to 7 days)
EMAIL_INVITES=

# ── Web ──────────────────────────────────────────────────
# Comma list of origins allowed to call the API (required on mainnet)
APP_ORIGINS=http://localhost:5173

# ── Sign-in (Privy: Google login + embedded Solana wallet) ──
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Sending to emails ────────────────────────────────────
# 32+ random characters; encrypts invite claim keys. Generate: openssl rand -hex 32
ESCROW_SECRET=
