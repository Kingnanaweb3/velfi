# ── Existing ─────────────────────────────────────────────
PORT=3001
JWT_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENROUTER_API_KEY=
RESEND_API_KEY=

# ── Solana ───────────────────────────────────────────────
# devnet while testing, mainnet-beta for launch
SOLANA_CLUSTER=devnet
# optional: a faster RPC (Helius, Triton, QuickNode). Defaults to the public endpoint.
SOLANA_RPC_URL=
# the program ID printed by `anchor deploy` (also in solana/Anchor.toml)
VELFI_PROGRAM_ID=
# Velfi's fee payer: pays network fees and token-account rent so users never need SOL.
# Paste the JSON array from a keypair file, e.g. `cat ~/.config/solana/velfi-fee-payer.json`
VELFI_FEE_PAYER_KEY=
# Autopilot agent key named in every schedule mandate (keep separate from the fee payer)
VELFI_AGENT_KEY=
# optional: override the USDC mint (e.g. your own devnet test mint)
USDC_MINT=
# optional: priority fee in micro-lamports per compute unit
PRIORITY_MICROLAMPORTS=1000
# optional: max fee-paid transactions per user per hour
MAX_TX_PER_HOUR=60
# optional: run schedules every N seconds for demos (leave empty in production)
SCHEDULE_DEMO_SECS=

# ── Sign-in (Privy: Google login + embedded Solana wallet) ──
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Sending to emails ────────────────────────────────────
# 32+ random characters; encrypts invite claim keys. Generate: openssl rand -hex 32
ESCROW_SECRET=
