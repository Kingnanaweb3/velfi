# ── Existing ─────────────────────────────────────────────
PORT=3001
JWT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# AI for the chat. Set ONE of these; Velfi uses the first one that has a value
# (usepod, then openrouter, then groq). Or force one with LLM_PROVIDER.
USEPOD_TOKEN=
OPENROUTER_API_KEY=
LLM_PROVIDER=
# optional: one model for every job (otherwise each provider has defaults)
VELFI_MODEL=
RESEND_API_KEY=

# ── BNB Chain ────────────────────────────────────────────
# testnet while testing, mainnet for launch
BNB_NETWORK=testnet
# RPC endpoint. Optional: defaults to BNB Chain's public endpoint. A private one
# (NodeReal, QuickNode, Ankr) is more reliable on mainnet.
BNB_RPC_URL=
# Velfi's gas wallet: covers users' network fees (a "gas drop" of exactly the
# missing BNB, right before their payment is sent). The only wallet you fund.
# A 64-character hex private key. Make one: node scripts/new-wallet.mjs
VELFI_GAS_KEY=
# Autopilot agent key: the only address users approve to spend for schedules.
# Keep it separate from the gas wallet. It gets its BNB from the gas wallet.
VELFI_AGENT_KEY=
# Testnet only: your test token addresses (mainnet uses the official USDT/USDC)
USDC_TOKEN=
USDT_TOKEN=
# optional: fixed gas price in gwei (normally Velfi follows the network)
GAS_PRICE_GWEI=
# optional: max fee-paid transactions per user per hour
MAX_TX_PER_HOUR=60
# optional: run schedules every N seconds for demos (testnet only; mainnet refuses to start with it)
SCHEDULE_DEMO_SECS=
# Gas wallet protection: biggest single gas drop, drops per user per day, BNB per day overall
MAX_GAS_DROP_BNB=0.002
MAX_GAS_DROPS_PER_DAY=20
MAX_GAS_DROP_BNB_PER_DAY=0.2
# Pause new payments (and fail /health) below this gas wallet balance
MIN_GAS_WALLET_BNB=0.02
# Largest total one schedule may cover (amount x payments), in that token
MAX_SCHEDULE_TOTAL=500

# Kill switch: 'on' stops new payments, scheduled payments and invite moves at once
PAUSE_PAYMENTS=
# 'off' turns off sending to email addresses (the money would otherwise wait in a
# holding wallet Velfi manages for up to 7 days)
EMAIL_INVITES=

# ── Web ──────────────────────────────────────────────────
# Comma list of origins allowed to call the API (required on mainnet)
APP_ORIGINS=http://localhost:5173

# ── Sign-in (Privy: Google login + embedded EVM wallet) ──
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ── Sending to emails ────────────────────────────────────
# 32+ random characters; encrypts invite claim keys. Generate: openssl rand -hex 32
ESCROW_SECRET=
